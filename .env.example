# ── Telegram ───────────────────────────────────────────────────────────────
# Get a token from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=

# ── 0G Chain (Galileo testnet) ─────────────────────────────────────────────
# Operator wallet: pays gas and (optionally) drips gas to freshly generated
# user wallets. 0x-prefixed 32-byte hex private key. Fund it from the 0G faucet.
OPERATOR_PRIVATE_KEY=

OG_RPC=https://evmrpc-testnet.0g.ai
# Chain id is reported as 16601 by most sources; some list 16602/80087.
# VERIFY against the live faucet/docs before sending real transactions.
OG_CHAIN_ID=16602

# Optional: amount of OG to send to each newly generated wallet so it can pay
# its own gas. "0" disables the drip.
WALLET_GAS_DRIP=0

# ── Key custody ────────────────────────────────────────────────────────────
# Passphrase used to encrypt user private keys at rest (AES-256-GCM).
# Use a long random string. CHANGING THIS makes existing stored keys unreadable.
WALLET_ENCRYPTION_KEY=
# Local encrypted wallet store (used by default and as a fallback/cache).
WALLET_STORE_PATH=.data/wallets.json

# ── 0G Storage (optional in this phase; off by default) ────────────────────
# When true, chat memory, username index, and wallet records are persisted to
# 0G Storage via file mode (uploadJson/downloadJson through the Indexer).
OG_STORAGE_ENABLED=false
OG_INDEXER_RPC=https://indexer-storage-testnet-turbo.0g.ai

# ── 0G Compute (Router — OpenAI-compatible) ───────────────────────────────
# Get an API key at https://pc.testnet.0g.ai (testnet) or https://pc.0g.ai (mainnet).
# Deposit a small amount of testnet OG, then create an API key in Dashboard.
OG_COMPUTE_API_KEY=
OG_COMPUTE_BASE_URL=https://router-api-testnet.integratenetwork.work/v1
# Verify available models in the dashboard; GLM-5-FP8 is shown in the official quickstart.
OG_COMPUTE_MODEL=qwen/qwen2.5-omni-7b

# Skip the official SDK broker and call OG_COMPUTE_BASE_URL directly.
# No TEE verification is possible in this mode. Use ONLY as a temporary fallback.
OG_COMPUTE_FALLBACK=false

# Amount of OG to top up the selected provider's inference sub-account at
# startup when the balance is below this threshold. Units are in OG (not neuron).
# The 0G Compute SDK requires MIN_LEDGER_BALANCE_OG=3 to create a ledger and
# MIN_TRANSFER_AMOUNT_CONTRACT=1 OG per transferFund. 3 OG covers both; the SDK
# docs use 5 OG as the typical transferFund example.
OG_COMPUTE_FUND_AMOUNT=3

# Optional explicit provider address. If set, the broker skips discovery and
# uses this provider. Must still satisfy serviceType='chatbot' and
# verifiability='TeeML' filters. Leave blank for automatic selection.
OG_COMPUTE_PROVIDER_ADDRESS=

# ── F1: Infinite Memory (0G Storage) ─────────────────────────────────────
# When true, all chat messages + tool calls + transactions are persisted to
# 0G Storage KV. When false, falls back to in-memory history (F2 behavior).
OG_MEMORY_ENABLED=true

# How many recent messages to fetch from 0G Storage as LLM context (per turn).
# Higher = better context awareness, higher storage read cost. 10-20 is sane.
OG_MEMORY_CONTEXT_WINDOW=10

# How many results search_history returns by default.
OG_MEMORY_SEARCH_LIMIT=20

# ── F1 File Mode: Root Hash Index ────────────────────────────────────────
# Path to the local root-hash index file. Maps userId → latest 0G Storage rootHash.
# Used as a cache. If lost, recorded transactions become unfindable on 0G Storage.
# IMPORTANT (prod): this MUST live on a persistent volume — if left on the
# ephemeral rootfs, every restart/redeploy wipes it. Leave BLANK to auto-derive it
# next to WALLET_STORE_PATH (recommended; lands on the same volume automatically).
OG_STORAGE_INDEX_PATH=

# Max memory entries to keep per user. When exceeded, oldest entries are pruned
# before uploading to 0G Storage. ~200-500 bytes per entry, so 1000 ≈ 200-500 KB.
# Set to 0 to disable compaction (not recommended — unbounded growth).
OG_MEMORY_MAX_ENTRIES=1000

# ── Swaps ─────────────────────────────────────────────────────────────────
# Wrapped OG (WOG) contract — deploy once via `npx tsx scripts/deployWog.ts`,
# then set the printed address here. Required for wrap/unwrap OG<->WOG.
WOG_ADDRESS=
# Optional Uniswap-V2-style DEX router — enables token<->token swaps when set
# to a router with liquidity on 0G Galileo. Leave blank to keep DEX swaps off.
# Deploy a demo DEX with `npx tsx scripts/deployDex.ts` (prints router + factory).
DEX_ROUTER_ADDRESS=
DEX_FACTORY_ADDRESS=
# Mock token addresses for the demo DEX (deploy via scripts/deployMockTokens.ts,
# then seed liquidity via scripts/seedLiquidity.ts). Enables OG<->USDC / OG<->USDT.
USDC_ADDRESS=
USDT_ADDRESS=
# Max slippage for DEX swaps, in basis points (50 = 0.5%).
SWAP_SLIPPAGE_BPS=50
# DEX swap deadline, in seconds from submission.
SWAP_DEADLINE_SECS=600

# ── Profile NFT (soulbound ERC-721) ───────────────────────────────────────
# Deploy the GalileoProfileNFT contract via `npx tsx scripts/deployNft.mjs`,
# then paste the printed address here. One NFT per user, minted automatically
# on first wallet creation. Leave blank to disable.
NFT_CONTRACT_ADDRESS=
